[Unit]
Description=PostgreSQL database server
Requires=boot-postgresql.service
After=network.target boot-postgresql.service

[Service]
Type=notify
ExecStart=/usr/pgsql-17/bin/postgres -c config_file=/etc/postgresql/postgresql.conf
KillMode=mixed
KillSignal=SIGINT
TimeoutStartSec=infinity
TimeoutStopSec=120

IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
